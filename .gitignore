# hype.efi build output (clang/lld -> x86_64-unknown-uefi)
*.o
*.obj
*.efi
*.lib
*.map
*.dll
*.pdb
build/
out/

# tools/make-usb-package.sh's generated output -- README.md and the
# .img/directory tree it builds are all regenerable, not source.
release/

# EDK2 guest firmware pipeline (separate build, plan.md §8)
edk2/Build/
edk2/Conf/
*.fd
*.rom
# ...except fw/'s own vendored OVMF blob (plan.md §7 -- "reuse a
# stripped EDK2/OVMF build as a vendored blob"), produced by
# tools/build-fw.sh, which *is* meant to be committed.
!fw/*.fd

# Disk images / test artifacts
*.img
*.qcow2
*.vhd
*.iso

# QEMU / debugging
*.pid
gdb.log

# Host-native unit test coverage runs (core/tests/run.sh), per-module
# binaries built without an extension (test_<module> -> from test_<module>.c)
*.profraw
*.profdata
*.gcda
*.gcno
core/tests/test_*
!core/tests/test_*.c

# Editor/OS cruft
.vscode/
.idea/
*.swp
.DS_Store

# FW-1g: locally-built DEBUG guest firmware (regenerate with FW_TARGET=DEBUG tools/build-fw.sh)
fw/OVMF_CODE.debug.fd
fw/OVMF_VARS.debug.fd

# Disk images and installer media -- every image, base or modified, lives here
# (disk-images/). None of it is source: the base ISOs are upstream downloads and
# the rest are regenerable ESP/scratch images built by tools/ and the QEMU rigs.
#
# Deliberately one directory rather than scattered: these are multi-GB files, and
# keeping them off /tmp matters because /tmp is a tmpfs -- RAM that a guest's own
# -m allocation needs. A 2 GB ESP image there competes with the VM it is meant to
# boot, and filling it takes the whole shell down with it.
disk-images/
