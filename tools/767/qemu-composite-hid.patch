+/*
+ * hype #767: a device that cannot be addressed.
+ *
+ * Real hardware has these -- a SuperSpeed hub below another hub on the 5950X answers
+ * Address Device with cc=4 (Transaction Error) every time, and its link keeps flapping so
+ * the parent hub re-reports the port forever. That drove #763 (retries without bound) and
+ * #770 (a hub reporting one port 4,610 times), both of which reached hardware unreproduced
+ * because nothing in QEMU refuses to be addressed.
+ *
+ * Every control transfer stalls, so SET_ADDRESS never completes and the host sees exactly
+ * the failure the real device produces.
+ */
+static void usb_badaddr_handle_control(USBDevice *dev, USBPacket *p, int request,
+                                       int value, int index, int length, uint8_t *data)
+{
+    p->status = USB_RET_STALL;
+}
+
+static void usb_badaddr_handle_data(USBDevice *dev, USBPacket *p)
+{
+    p->status = USB_RET_STALL;
+}
+
+static void usb_badaddr_realize(USBDevice *dev, Error **errp)
+{
+    USBHIDState *us = USB_HID(dev);
+
+    dev->usb_desc = &desc_keyboard;
+    usb_desc_create_serial(dev);
+    usb_desc_init(dev);
+    us->intr = usb_ep_get(dev, USB_TOKEN_IN, 1);
+}
+
+static void usb_badaddr_class_initfn(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    USBDeviceClass *uc = USB_DEVICE_CLASS(klass);
+
+    uc->realize        = usb_badaddr_realize;
+    uc->handle_control = usb_badaddr_handle_control;
+    uc->handle_data    = usb_badaddr_handle_data;
+    uc->product_desc   = "QEMU USB device that refuses to be addressed";
+    set_bit(DEVICE_CATEGORY_INPUT, dc->categories);
+}
+
+static const TypeInfo usb_badaddr_info = {
+    .name          = "usb-badaddr",
+    .parent        = TYPE_USB_HID,
+    .class_init    = usb_badaddr_class_initfn,
+};
+
+/* hype #767: the composite. No vmsd -- this exists for host-driver testing, not migration. */
+static void usb_kbd_mouse_class_initfn(ObjectClass *klass, const void *data)
