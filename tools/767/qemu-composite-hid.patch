+/*
+ * hype #767: a composite boot-HID device -- one USB device presenting a boot MOUSE
+ * interface on endpoint 1 and a boot KEYBOARD interface on endpoint 2.
+ *
+ * Every stock QEMU HID is single-interface, so a host that claims a device twice on one
+ * slot -- once per interface -- has nothing to exercise it against. That is ordinary
+ * hardware: a wireless receiver is exactly this shape. hype's #755 (a second Configure
+ * Endpoint lowering Context Entries and invalidating the first) and #771 (two claims
+ * sharing one transfer ring) both live on that path and both reached real hardware
+ * unreproduced.
+ */
+static void usb_kbd_mouse_realize(USBDevice *dev, Error **errp)
+{
+    USBHIDState *us = USB_HID(dev);
+
+    us->composite = true;
+    dev->usb_desc = &desc_combo;
+    usb_desc_create_serial(dev);
+    usb_desc_init(dev);
+    us->intr = usb_ep_get(dev, USB_TOKEN_IN, 1);
+    us->intr2 = usb_ep_get(dev, USB_TOKEN_IN, 2);
+    hid_init(&us->hid, HID_MOUSE, usb_hid_changed);
+    hid_init(&us->hid2, HID_KEYBOARD, usb_hid2_changed);
+}
+
