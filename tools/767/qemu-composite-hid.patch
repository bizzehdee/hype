+/*
+ * hype #767: the composite's SECOND interface.
+ *
+ * container_of() above resolves against the `hid` member, so calling it with &us->hid2
+ * yields a pointer short of the real object -- a wild `us->intr` and undefined behaviour.
+ * The second interface needs its own callback and its own endpoint.
+ */
+static void usb_hid2_changed(HIDState *hs)
+{
+    USBHIDState *us = container_of(hs, USBHIDState, hid2);
+
+    usb_wakeup(us->intr2, 0);
+}
