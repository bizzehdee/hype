+    USBDeviceClass *uc = USB_DEVICE_CLASS(klass);
+
+    uc->realize        = usb_kbd_mouse_realize;
+    uc->product_desc   = "QEMU USB composite keyboard+mouse";
+    set_bit(DEVICE_CATEGORY_INPUT, dc->categories);
+}
+
+static const TypeInfo usb_kbd_mouse_info = {
+    .name          = "usb-kbd-mouse",
+    .parent        = TYPE_USB_HID,
+    .class_init    = usb_kbd_mouse_class_initfn,
+};
